# Required. Free key (100 requests/day, species 1-3000): https://perenual.com/docs/api
PERENUAL_API_KEY=

# Optional. Enables the `listed-companion` signal in companion_check.
# Data is CC BY-SA 4.0 -- see the licensing note in the README.
# Sign up: https://permapeople.org/knowledgebase/api-docs.html
PERMAPEOPLE_KEY_ID=
PERMAPEOPLE_KEY_SECRET=

# Optional. Registers the experimental identify_plant tool.
# Requires Perenual beta access ("REQUEST BETA ACCESS" at
# https://perenual.com/docs/identify/api)
PERENUAL_IDENTIFY_BETA=

# Optional overrides
# PLANT_INTEL_CACHE_DIR=
# PLANT_INTEL_CACHE_DISABLED=1
